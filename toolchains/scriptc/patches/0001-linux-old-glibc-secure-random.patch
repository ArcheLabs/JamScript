+/* Linux glibc before 2.36 does not declare arc4random_buf. Keep the
+ * runtime's CSPRNG contract independent of the host libc by using the
+ * kernel-backed JamScript shim on every non-musl Linux build. A unique
+ * symbol avoids colliding with newer libcs that do provide arc4random_buf. */
+#if defined(__linux__) && !defined(SCR_MUSL)
+void jamscript_secure_random(void *buf, size_t n);
+#define SCR_RUNTIME_RANDOM jamscript_secure_random
+#else
+#define SCR_RUNTIME_RANDOM arc4random_buf
+#endif
