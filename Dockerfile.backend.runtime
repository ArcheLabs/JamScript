FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home jamscript

COPY bin/jamscript-service-backend /usr/local/bin/jamscript-service-backend
RUN chmod 0755 /usr/local/bin/jamscript-service-backend \
    && mkdir -p /var/lib/jamscript \
    && chown -R jamscript:jamscript /var/lib/jamscript

USER jamscript
ENV JAMSCRIPT_BACKEND_BIND=0.0.0.0:8090 \
    JAMSCRIPT_BACKEND_DATA=/var/lib/jamscript
VOLUME ["/var/lib/jamscript"]
EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s CMD curl --fail --silent http://127.0.0.1:8090/readinessz
ENTRYPOINT ["/usr/local/bin/jamscript-service-backend"]
